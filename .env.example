# ============================================================
# IPL Auction Event Management System - Environment Variables
# ============================================================
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file.

# MongoDB connection string (MongoDB Atlas / local)
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ipl_auction
MONGODB_URI=

# Secret used to sign JWT tokens (use a long random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Backend server port
PORT=5000

# Frontend origin allowed for CORS + Socket.IO
CLIENT_URL=http://localhost:5173

# Seed admin account (created by "npm run seed")
ADMIN_NAME=Event Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional seed conductor account
CONDUCTOR_NAME=Event Conductor
CONDUCTOR_EMAIL=conductor@example.com
CONDUCTOR_PASSWORD=

# Default scoring weights (must total 100)
RANKING_WEIGHT=70
PURSE_WEIGHT=30
